+    d = _src("common/dilution.py")
+    assert "gap_pct(outstanding[1]" in d and "/ vals[now_i] - 1) * 100" not in d
+    assert '_fh["outstanding_gap_pct"]' not in _src("src/value/tanuki_valuation/pipeline.py")
